{
  "name": "maqueta-jujuy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Maqueta 3D del relieve de Jujuy (WebGPU + vgpu)",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:data && npm run build:detail && npm run build:places && tsc --noEmit && vite build && node scripts/prune-dist.mjs",
    "build:data": "tsx scripts/build-data.ts",
    "build:detail": "tsx scripts/build-detail.ts",
    "build:places": "tsx scripts/build-places.ts",
    "verify:boundaries": "tsx scripts/verify-boundaries.ts",
    "verify:detail": "tsx scripts/verify-detail.ts",
    "verify:places": "tsx scripts/verify-places.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "check:wgsl": "node scripts/check-wgsl.mjs",
    "snapshot": "tsx scripts/render-snapshot.ts"
  },
  "dependencies": {
    "vgpu": "0.5.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@vgpu/wgsl": "0.5.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
